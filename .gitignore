# Xcode generated
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscheme

# Info.plist is owned by xcodegen — populated from project.yml on each generate
Maugham/Info.plist

# Build artifacts
build/
*.app
*.dSYM/
*.ipa

# Swift Package Manager
# NOTE: do NOT ignore Packages/ wholesale — Packages/MaughamCore is first-party
# source shared by the macOS app and the iOS companion. `.build/` already ignores
# SPM build output at any depth (incl. Packages/*/.build/).
.build/
Package.resolved

# macOS
.DS_Store
._*

# Maugham app-private project state (when generated by tests in temp dirs)
.maugham/
.superpowers/

# Agent tooling working dirs (never tracked)
.claude/
.claire/
